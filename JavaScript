// randomize feat badges in floating tray (keeps them accessible)
(function randomizeFeatBadges() {
  const tray = document.querySelector('.floating-feats');
  if (!tray) return;
  const badges = Array.from(tray.querySelectorAll('.feat-badge'));
  const trayRect = tray.getBoundingClientRect();
  // limit offset so badges stay visible and wrap normally
  badges.forEach((b, idx) => {
    const maxX = Math.max(0, tray.clientWidth - b.offsetWidth - 6);
    const maxY = Math.max(0, tray.clientHeight - b.offsetHeight - 6);
    const x = Math.round((Math.random() * maxX) * (idx % 2 ? 0.6 : 1)); // bias different rows
    const y = Math.round((Math.random() * maxY) * (idx % 3 ? 0.5 : 1));
    b.style.transform = `translate(${x}px, ${y}px)`;
    b.style.transition = 'transform 700ms cubic-bezier(.2,.9,.3,1)';
  });

  // optionally re-randomize a little after load for subtle motion:
  setTimeout(() => {
    badges.forEach((b, idx) => {
      const jitter = (Math.random() * 6) - 3;
      b.style.transform += ` translateY(${jitter}px)`;
    });
  }, 1000);
})();
